# bubblegauge as a Podman Quadlet unit (owner decision D6, 2026-09-28).
#
# Install once (docs/AUTO_DEPLOY.md): copy to ~/.config/containers/systemd/,
# `systemctl --user daemon-reload`, `systemctl --user start bubblegauge.service`.
# systemd then starts it at boot (with linger) and restarts it when it dies;
# deploy.sh only moves :latest and restarts it.

[Unit]
Description=bubblegauge API and scheduler
Wants=network-online.target
After=network-online.target
# No start limit: this unit is the service's only keeper once a rollback has
# failed, and systemd's default (five starts in ten seconds) left a
# fast-crashing service in `failed` for good, down after the fault cleared
# (#143 round 30, SOTA-A; reproduced on leaf: NRestarts=5, then nothing).
StartLimitIntervalSec=0

[Container]
ContainerName=bubblegauge
Image=localhost/bubblegauge:latest
EnvironmentFile=%h/playground/bubble-regime-monitor/.env
# :z, the SELinux label every container that mounts /data shares: deploy.sh's
# revision and migration containers mount it too, and a private :Z relabelled it
# away from this one (#143 round 8, SOTA-A).
Volume=%h/playground/bubble-regime-monitor/data:/data:z
# Loopback only: the reverse proxy (nginx-proxy-manager, host network) is the
# one way in. Rootless Podman's port handler rewrites every forwarded
# connection's source to 10.0.2.100 inside the container, so uvicorn trusts
# X-Forwarded-For from exactly that hop and keys each visitor by the address
# the proxy appended; "*" would take the LEFTMOST entry, which a client writes.
# The trust boundary is the HOST: every local process that connects to the
# loopback port arrives as the same hop (uvicorn's own default draws the same
# line at 127.0.0.1); leaf is single-tenant.
PublishPort=127.0.0.1:8000:8000
Environment=FORWARDED_ALLOW_IPS=10.0.2.100
# The resolvers compose.yml pins since the July 2026 outage (broken in-container
# DNS: no provider was ever contacted). The container deploy.sh ran without
# them resolved on this host, and so does this one with them: checked
# 2026-09-29 from the image, the providers and hc-ping.com resolve, and the
# gateway and iMessage hosts get the same addresses from 1.1.1.1 as from the
# host's resolver (#143 round 13, SOTA-A).
DNS=1.1.1.1
DNS=8.8.8.8
# Hardening (audit B-12): no capabilities, no privilege escalation. The image
# runs as container-root, which rootless Podman maps to the unprivileged host
# user; that is what keeps the /data bind mount writable.
DropCapability=ALL
NoNewPrivileges=true

[Service]
Restart=always
# ... every ten seconds, so a crash loop is a restart every ten seconds, not a spin.
RestartSec=10s
TimeoutStartSec=300

[Install]
WantedBy=default.target
