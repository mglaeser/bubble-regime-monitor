# Host-side alert watchdog for bubblegauge.
#
# This runs OUTSIDE the container on purpose. A watchdog that only runs as a
# callback after a successful recompute cannot notice that recomputes have
# stopped — which is the failure it exists to catch.
#
# It is still not a complete answer: a total host or network failure silences
# this timer too. That needs external monitoring, and no amount of local
# scheduling substitutes for it.
#
# Install (rootless podman, user units):
#   cp deploy/systemd/bubblegauge-alert-watchdog.* ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now bubblegauge-alert-watchdog.timer
#
# Exit codes (app/alerts/watchdog.py decides them): 0 = healthy, 2 = outage
# detected and handed to the alert path (the run passes the outbox itself and
# sends what is due), 1 = outage detected and the alert path did not take it:
# the unit fails and OnFailure= reports it.

[Unit]
Description=bubblegauge alert watchdog (missed recompute slots)
After=network-online.target
# A failed unit notifies nobody by itself. Without this line a stopped
# container makes `podman exec` exit 125, the unit is marked failed, and
# the operator is told nothing — the 344h silence of 2026-08.
OnFailure=bubblegauge-alert-watchdog-failed.service

[Service]
Type=oneshot
# Adjust the container name and, if the service runs directly, the working
# directory and interpreter.
ExecStart=/usr/bin/podman exec bubblegauge python -m app.alerts.watchdog --once
# Exit 2 means "outage detected and handed to the alert path", not "the unit
# failed". Exit 1 is not listed and must not be: it is the outage the alert
# path did not take, and the failed unit is what reports it.
SuccessExitStatus=0 2
TimeoutStartSec=120
