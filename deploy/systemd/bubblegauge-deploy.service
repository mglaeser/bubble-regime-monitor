# Started by bubblegauge-deploy.timer. A oneshot service never runs twice at
# once, so deploys cannot overlap.

[Unit]
Description=bubblegauge deploy (fetch main; when it moved: build, migrate, restart, health-check, roll back on failure)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/playground/bubble-regime-monitor
ExecStart=%h/playground/bubble-regime-monitor/deploy.sh
TimeoutStartSec=3600
NoNewPrivileges=true
