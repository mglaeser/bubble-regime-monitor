[Unit]
Description=bubblegauge auto-deploy (consume trigger, run deploy.sh)
Documentation=file://%h/playground/bubble-regime-monitor/docs/AUTO_DEPLOY.md
# Serialize with the app container's own lifecycle is unnecessary; deploy.sh is
# idempotent and self-locks. We only need network for git fetch + registry.
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# All configuration lives in this env file (REPO_DIR, DEPLOY_BRANCH, ...).
# Copy deploy/bubblegauge-deploy.env.example there and edit it.
EnvironmentFile=%h/.config/bubblegauge/deploy.env
ExecStart=%h/playground/bubble-regime-monitor/deploy/deploy-watch.sh

# Hardening: this unit runs as your unprivileged user (systemd --user). It needs
# to run podman + git in the repo, so we keep it modest rather than locked down.
NoNewPrivileges=true

# A cold image build (R + exuber compile) can exceed 30 min; the original 1800 s
# killed a deploy 70 s before it finished (2026-07-17 incident, on the slower
# host of the time). Kept generous — headroom costs nothing when builds are fast.
TimeoutStartSec=3600

# CRITICAL: deploy.sh starts the long-lived rootless-podman container from
# inside this unit, so conmon/slirp4netns/rootlessport end up in THIS unit's
# cgroup. The default KillMode=control-group would SIGKILL the freshly
# deployed container's runtime on any stop/timeout (exactly what the 2026-07-17
# incident did). KillMode=process kills only deploy-watch.sh itself and leaves
# the container processes alone.
KillMode=process
TimeoutStopSec=15

[Install]
WantedBy=default.target
