# Started by bubblegauge-deploy.timer, or by hand with
# `systemctl --user start bubblegauge-deploy.service`. systemd runs one
# instance of a oneshot service at a time, and stopping it - or its main
# process dying - stops every process it started (the default
# KillMode=control-group): deploys neither overlap nor outlive their run.
# deploy.sh refuses to run unless it is this unit's main process, by
# systemd's own answer (#143 rounds 15 and 27).

[Unit]
Description=bubblegauge deploy (fetch main; when it moved: build, migrate, restart, health-check, roll back on failure)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/playground/bubble-regime-monitor
ExecStart=%h/playground/bubble-regime-monitor/deploy.sh
TimeoutStartSec=3600
# No NoNewPrivileges here: rootless Podman sets up its user namespace with the
# setuid helpers newuidmap/newgidmap, which that setting blocks. Executed on
# the host with a fresh namespace: "newuidmap: write to uid_map failed:
# Operation not permitted; cannot set up namespace" under it, fine without
# (#143 round 22, SOTA-A). The container unit keeps its own NoNewPrivileges.
