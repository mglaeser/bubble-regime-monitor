# bubblegauge auto-deploy watchdog config.
#
# Copy to ~/.config/bubblegauge/deploy.env and edit. Referenced by
# deploy/systemd/bubblegauge-deploy.service (EnvironmentFile=).
#
#   install -Dm600 deploy/bubblegauge-deploy.env.example ~/.config/bubblegauge/deploy.env
#   ${EDITOR:-nano} ~/.config/bubblegauge/deploy.env
#
# NOTE: systemd EnvironmentFile is NOT a shell — no $VAR expansion, no quotes
# stripping tricks. Write literal absolute values (e.g. /home/you/...), not %h.

# Absolute path to the repo checkout on the host (REQUIRED).
REPO_DIR=/home/youruser/playground/bubble-regime-monitor

# Branch the watchdog deploys (REQUIRED). This is PINNED here on the host, and
# deploy-watch.sh ignores whatever ref/sha the trigger file names — a forged
# trigger can at most redeploy this legitimate branch. Set it to the branch you
# actually run in production (your PR target, e.g. main).
DEPLOY_BRANCH=main

# Trigger file the app writes on the shared /data volume (OPTIONAL).
# Default: $REPO_DIR/data/deploy-trigger/deploy-requested — matches the app's
# DEPLOY_TRIGGER_DIR=/data/deploy-trigger when /data is bound to $REPO_DIR/data.
# TRIGGER_FILE=/home/youruser/playground/bubble-regime-monitor/data/deploy-trigger/deploy-requested

# Append a deploy log here (OPTIONAL; stdout/journald always gets it too).
# LOG_FILE=/home/youruser/playground/bubble-regime-monitor/data/deploy.log
