# D1 — trusted count lane. INERT TEMPLATE. NOT DEPLOYABLE AS WRITTEN.
#
# The `.yml.template` extension is the containment: GitHub reads only `.yml` and
# `.yaml` in `.github/workflows/`, so copying this directory there activates
# nothing. Renaming this file is a deliberate deployment act, gated on
# RELEASE_EXECUTION_CONTRACT_v1 §13 Phase B and operator prerequisites 1–15.
#
# What D1 is allowed to do: authenticate operator records, mint a challenge,
# preflight every request, and call POST /v1/responses/input_tokens. It makes
# ZERO generation calls. Generation is D2 and a separate approval.
#
# WHAT CHANGED (EX3-R01). The credential-bearing steps used to be
#
#     echo "engine verification is implemented in the D1 activation PR"
#     exit 1
#
# and a `phases.assert_phase_permitted(phases.D1)` that refuses. Accurate, and
# not a runtime. The lane is now `trustedlane.d1runtime.run`, which is the whole
# ordered sequence with every gate in front of the credential rather than beside
# it, and which is exercised end to end against a fake server in the D0 suite.
#
# The two things this file still cannot do from a reviewed branch are the two
# that matter: `transport.read_credential` and `transport.open_https` compare
# against `phases.IMPLEMENTED_PHASE`, which is a deployment fact. Until this
# file is renamed AND that constant is raised in a protected commit, both
# refuse — so activating the lane is two deliberate acts, not one.
#
# Action pins (immutable SHAs, release mapping in actionpolicy.py):
#   actions/checkout        11d5960a326750d5838078e36cf38b85af677262  (v4.4.0)
#   actions/setup-python    a26af69be951a213d495a4c3e4e4022e16d87065  (v5.6.0)
#
# The candidate range arrives as two SHAs and nothing else. There is no
# repository or remote input: the source is fixed in trusted policy
# (trustedlane.CANONICAL_REPOSITORY) so the numeric-id check downstream compares
# two values the caller could not both have chosen.

name: trusted-lane-d1-count

on:
  workflow_dispatch:
    inputs:
      target_base_sha:
        description: Candidate range base commit (40-hex, inert data)
        required: true
        type: string
      candidate_head_sha:
        description: Candidate range head commit (40-hex, inert data)
        required: true
        type: string
      operator_authorization_sha256:
        description: Digest of the operator authorization record held outside this repository
        required: true
        type: string

permissions:
  contents: read

defaults:
  run:
    shell: bash

jobs:
  # Containment runs first and everything credential-bearing is gated behind it.
  d1-containment-gate:
    runs-on: ubuntu-latest
    permissions:
      contents: read
    steps:
      - name: Check out the trusted engine from the protected ref only
        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262  # v4.4.0
        with:
          persist-credentials: false
          fetch-depth: 0
      - name: Set up Python
        uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065  # v5.6.0
        with:
          python-version: '3.12'
      - name: Containment invariants
        env:
          EVENT_REPOSITORY_ID: ${{ github.repository_id }}
          OBSERVED_REF: ${{ github.ref }}
        run: |
          python - <<'PROBE'
          import os, sys
          sys.path.insert(0, "scripts")
          from trustedlane import enginepolicy, identity
          identity.assert_repository_numeric_id(int(os.environ["EVENT_REPOSITORY_ID"]))
          identity.assert_allowed_default_ref(os.environ["OBSERVED_REF"])
          enginepolicy.assert_no_candidate_import()
          PROBE

  trusted-verifier-count:
    needs: d1-containment-gate
    runs-on: ubuntu-latest
    # `environment:` is what makes the key reachable, and the environment's own
    # deployment-branch policy is what keeps an unprotected ref out. There is
    # deliberately NO repository- or organization-level fallback secret: a
    # repo-level secret is readable from ANY ref and would silently defeat this.
    environment: trusted-verifier
    permissions:
      contents: read
    steps:
      - name: Check out the trusted engine from the protected ref only
        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262  # v4.4.0
        with:
          persist-credentials: false
          fetch-depth: 0

      - name: Set up Python
        uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065  # v5.6.0
        with:
          python-version: '3.12'

      # Hash-locked, one package. `--require-hashes` is the point: a pinned
      # version still lets a compromised index serve different bytes under the
      # same number, on a machine that is about to hold a provider key. There is
      # no pytest here — D1 counts, it does not run tests, and a test framework
      # is a plugin loader and an entry-point scan next to a key (EX3-R06).
      - name: Install the hash-locked runtime
        run: |
          python -m pip install --require-hashes --no-deps \
            -r requirements-trusted-runtime.txt
          python - <<'PROBE'
          import sys
          sys.path.insert(0, "scripts")
          from trustedlane import runtimelock
          print(runtimelock.load_lock()["lock_sha256"])
          PROBE

      # The engine is verified against an operator-approved digest and unpacked
      # into an empty directory — never imported from the candidate checkout.
      # The candidate repository is fetched separately, --no-checkout, as inert
      # data.
      - name: Verify and unpack the approved engine artifact
        env:
          TRUSTED_ENGINE_DIGEST: ${{ vars.TRUSTED_ENGINE_ARTIFACT_SHA256 }}
          TRUSTED_ENGINE_ARTIFACT_PATH: ${{ runner.temp }}/engine.tar.gz
          TRUSTED_ENGINE_ROOT: ${{ runner.temp }}/engine
        run: |
          mkdir -p "$TRUSTED_ENGINE_ROOT"
          python - <<'PROBE'
          import json, os, sys
          sys.path.insert(0, "scripts")
          from trustedlane import artifactload
          record = artifactload.extract(
              os.environ["TRUSTED_ENGINE_ARTIFACT_PATH"],
              destination=os.environ["TRUSTED_ENGINE_ROOT"],
              expected_sha256=os.environ["TRUSTED_ENGINE_DIGEST"])
          artifactload.assert_engine_root_is_not_the_candidate(
              os.environ["TRUSTED_ENGINE_ROOT"])
          print(json.dumps({"files": record["file_count"],
                            "sha256": record["engine_artifact_sha256"]}))
          PROBE

      - name: Trusted count
        env:
          # Referenced BY NAME. No value lives in this file, and the name
          # resolves to nothing outside the protected environment.
          TRUSTED_VERIFIER_OPENAI_KEY: ${{ secrets.TRUSTED_VERIFIER_OPENAI_KEY }}
          TRUSTED_EVIDENCE_SIGNING_KEY: ${{ secrets.TRUSTED_EVIDENCE_SIGNING_KEY }}
          TARGET_BASE_SHA: ${{ inputs.target_base_sha }}
          CANDIDATE_HEAD_SHA: ${{ inputs.candidate_head_sha }}
          OPERATOR_AUTHORIZATION_SHA256: ${{ inputs.operator_authorization_sha256 }}
          TRUSTED_ENGINE_ROOT: ${{ runner.temp }}/engine
          TRUSTED_ENGINE_ARTIFACT_PATH: ${{ runner.temp }}/engine.tar.gz
          TRUSTED_ENGINE_DIGEST: ${{ vars.TRUSTED_ENGINE_ARTIFACT_SHA256 }}
          TRUSTED_OBSERVATION_PATH: ${{ runner.temp }}/protected-state.json
          TRUSTED_OPERATOR_RECORDS_PATH: ${{ runner.temp }}/operator-records.json
          # The CANDIDATE's declared plan and the inert clone destination. Both
          # are candidate data and both live outside the engine root: putting
          # the reviewed branch's claims inside the trusted artifact would make
          # the rebuild comparison compare the engine against itself.
          TRUSTED_CANDIDATE_PLAN_PATH: ${{ runner.temp }}/candidate/candidate-plan.json
          TRUSTED_CANDIDATE_CHECKOUT: ${{ runner.temp }}/candidate
          TRUSTED_MODEL_ID: ${{ vars.TRUSTED_VERIFIER_MODEL_ID }}
          TRUSTED_RUN_ID: ${{ github.run_id }}
          TRUSTED_RUN_ATTEMPT: ${{ github.run_attempt }}
          TRUSTED_RUN_URL: ${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }}
          OBSERVED_REF: ${{ github.ref }}
          EVENT_REPOSITORY_ID: ${{ github.repository_id }}
        run: |
          # One call. `d1cli.main` assembles every argument from the environment
          # and runs the ordered sequence: protected-state observation, engine
          # verification, operator-record verification, occurrence-scoped
          # literal authorization, challenge minting, inert fetch, trusted
          # skeleton rebuild, pending status on the candidate head, per-unit
          # global preflight and count, ledger close with zero generation
          # calls, signed TRUSTED_COUNT_EVIDENCE, terminal status.
          #
          # It is a module rather than a heredoc because a heredoc is not a
          # place where refusals can be tested, and the previous version of
          # this step was a heredoc containing `exit 1`.
          #
          # `TRUSTED_OBSERVED_NOW` is set HERE, from the runner's clock, and is
          # deliberately NOT a `vars.` repository variable. It was one, and a
          # repository variable is a fixed string: operator-record expiry would
          # have been compared against the same frozen instant on every future
          # run, and every signed record would have carried the same
          # `produced_at`. An expiry that never advances is not an expiry.
          # Found by adversarial review.
          export TRUSTED_OBSERVED_NOW="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
          # `laneentry` is the process boundary: it catches every exception,
          # prints one sanitized line and exits non-zero, so no traceback —
          # whose frames can carry a path, a header or a response fragment —
          # reaches the log of a step that holds a provider key.
          python -c 'import sys; sys.path.insert(0, "scripts"); \
            from trustedlane import laneentry; \
            sys.exit(laneentry.main("D1"))'
