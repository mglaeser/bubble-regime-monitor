# D2 — trusted generation lane. INERT TEMPLATE. NOT DEPLOYABLE AS WRITTEN.
#
# Same containment as D1: `.yml.template` is not a workflow. Activation is
# RELEASE_EXECUTION_CONTRACT_v1 §13 Phase C and requires operator prerequisite
# 16 — generation approved as its own decision, after trusted counting exists
# and its cost is known. An approval to count has never been an approval to
# generate.
#
# D2 uses a SEPARATE protected environment from D1 so that approving counting
# does not, by environment reuse, approve generating.
#
# WHAT CHANGED (EX3-R01). The credential-bearing steps used to be
#
#     echo "engine verification is implemented in the D2 activation PR"
#     exit 1
#
# and a `phases.assert_phase_permitted(phases.D2)` that refuses. The lane is now
# `trustedlane.d2runtime.run`, assembled by `trustedlane.d2cli`, and exercised
# end to end against a fake server in the D0 suite. `d2runtime` is a separate
# module from `d1runtime` on purpose: a shared `run(generate=True)` would put
# the difference between counting and generating inside a branch nobody reads.
#
# Action pins (immutable SHAs, release mapping in actionpolicy.py):
#   actions/checkout        11d5960a326750d5838078e36cf38b85af677262  (v4.4.0)
#   actions/setup-python    a26af69be951a213d495a4c3e4e4022e16d87065  (v5.6.0)

name: trusted-lane-d2-generation

on:
  workflow_dispatch:
    inputs:
      trusted_plan_sha256:
        description: Digest of the trusted executable review plan produced by D1
        required: true
        type: string
      generation_authorization_sha256:
        description: Digest of the separate operator generation approval
        required: true
        type: string

permissions:
  contents: read

defaults:
  run:
    shell: bash

jobs:
  d2-containment-gate:
    runs-on: ubuntu-latest
    permissions:
      contents: read
    steps:
      - name: Check out the trusted engine from the protected ref only
        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262  # v4.4.0
        with:
          persist-credentials: false
          fetch-depth: 0
      - name: Set up Python
        uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065  # v5.6.0
        with:
          python-version: '3.12'
      - name: Containment invariants
        env:
          EVENT_REPOSITORY_ID: ${{ github.repository_id }}
          OBSERVED_REF: ${{ github.ref }}
        run: |
          python - <<'PROBE'
          import os, sys
          sys.path.insert(0, "scripts")
          from trustedlane import enginepolicy, identity
          identity.assert_repository_numeric_id(int(os.environ["EVENT_REPOSITORY_ID"]))
          identity.assert_allowed_default_ref(os.environ["OBSERVED_REF"])
          enginepolicy.assert_no_candidate_import()
          PROBE

  trusted-cross-vendor-review:
    needs: d2-containment-gate
    runs-on: ubuntu-latest
    environment: trusted-verifier-generation
    permissions:
      contents: read
    steps:
      - name: Check out the trusted engine from the protected ref only
        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262  # v4.4.0
        with:
          persist-credentials: false
          fetch-depth: 0

      - name: Set up Python
        uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065  # v5.6.0
        with:
          python-version: '3.12'

      # Hash-locked, one package, no pytest — the same lock D1 installs, for
      # the same reason: a pinned version still lets a compromised index serve
      # different bytes under the same number, on a machine about to hold a key.
      - name: Install the hash-locked runtime
        run: |
          python -m pip install --require-hashes --no-deps \
            -r requirements-trusted-runtime.txt

      - name: Verify and unpack the approved engine artifact
        env:
          TRUSTED_ENGINE_DIGEST: ${{ vars.TRUSTED_ENGINE_ARTIFACT_SHA256 }}
          TRUSTED_ENGINE_ARTIFACT_PATH: ${{ runner.temp }}/engine.tar.gz
          TRUSTED_ENGINE_ROOT: ${{ runner.temp }}/engine
        run: |
          mkdir -p "$TRUSTED_ENGINE_ROOT"
          python - <<'PROBE'
          import json, os, sys
          sys.path.insert(0, "scripts")
          from trustedlane import artifactload
          record = artifactload.extract(
              os.environ["TRUSTED_ENGINE_ARTIFACT_PATH"],
              destination=os.environ["TRUSTED_ENGINE_ROOT"],
              expected_sha256=os.environ["TRUSTED_ENGINE_DIGEST"])
          artifactload.assert_engine_root_is_not_the_candidate(
              os.environ["TRUSTED_ENGINE_ROOT"])
          print(json.dumps({"files": record["file_count"],
                            "sha256": record["engine_artifact_sha256"]}))
          PROBE

      - name: Trusted generation
        env:
          # A DIFFERENT secret in a DIFFERENT environment under a DIFFERENT
          # operator prerequisite. Reusing D1's would make an approval to count
          # an approval to generate by accident.
          TRUSTED_VERIFIER_OPENAI_KEY: ${{ secrets.TRUSTED_VERIFIER_OPENAI_KEY }}
          TRUSTED_EVIDENCE_SIGNING_KEY: ${{ secrets.TRUSTED_EVIDENCE_SIGNING_KEY }}
          TRUSTED_PLAN_SHA256: ${{ inputs.trusted_plan_sha256 }}
          TRUSTED_PLAN_PATH: ${{ runner.temp }}/trusted-plan.json
          GENERATION_AUTHORIZATION_SHA256: ${{ inputs.generation_authorization_sha256 }}
          TRUSTED_ENGINE_ROOT: ${{ runner.temp }}/engine
          TRUSTED_ENGINE_ARTIFACT_PATH: ${{ runner.temp }}/engine.tar.gz
          TRUSTED_ENGINE_DIGEST: ${{ vars.TRUSTED_ENGINE_ARTIFACT_SHA256 }}
          TRUSTED_ENGINE_SOURCE_SHA256: ${{ vars.TRUSTED_ENGINE_SOURCE_SHA256 }}
          TRUSTED_OBSERVATION_PATH: ${{ runner.temp }}/protected-state.json
          TRUSTED_OPERATOR_RECORDS_PATH: ${{ runner.temp }}/operator-records.json
          TRUSTED_MODEL_ID: ${{ vars.TRUSTED_VERIFIER_MODEL_ID }}
          TARGET_BASE_SHA: ${{ vars.TRUSTED_TARGET_BASE_SHA }}
          CANDIDATE_HEAD_SHA: ${{ vars.TRUSTED_CANDIDATE_HEAD_SHA }}
          TRUSTED_RUN_ID: ${{ github.run_id }}
          TRUSTED_RUN_ATTEMPT: ${{ github.run_attempt }}
          TRUSTED_RUN_URL: ${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }}
          OBSERVED_REF: ${{ github.ref }}
          EVENT_REPOSITORY_ID: ${{ github.repository_id }}
        run: |
          # From the runner's clock, not a `vars.` repository variable — see
          # the note in the D1 template. An expiry compared against a frozen
          # instant never expires.
          export TRUSTED_OBSERVED_NOW="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
          # `laneentry` keeps every traceback out of a credential-bearing log.
          python -c 'import sys; sys.path.insert(0, "scripts"); \
            from trustedlane import laneentry; \
            sys.exit(laneentry.main("D2"))'
