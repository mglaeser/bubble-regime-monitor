# D2 — trusted generation lane. INERT TEMPLATE. NOT DEPLOYABLE AS WRITTEN.
#
# Same containment as D1: `.yml.template` is not a workflow. Activation is
# RELEASE_EXECUTION_CONTRACT_v1 §13 Phase C and requires operator prerequisite
# 16 — generation approved as its own decision, after trusted counting exists
# and its cost is known. An approval to count has never been an approval to
# generate.
#
# D2 uses a SEPARATE protected environment from D1 so that approving counting
# does not, by environment reuse, approve generating.
#
# WHAT CHANGED (EX3-R01). The credential-bearing steps used to be
#
#     echo "engine verification is implemented in the D2 activation PR"
#     exit 1
#
# and a `phases.assert_phase_permitted(phases.D2)` that refuses. The lane is now
# `trustedlane.d2runtime.run`, assembled by `trustedlane.d2cli`, and exercised
# end to end against a fake server in the D0 suite. `d2runtime` is a separate
# module from `d1runtime` on purpose: a shared `run(generate=True)` would put
# the difference between counting and generating inside a branch nobody reads.
#
# Action pins (immutable SHAs, release mapping in actionpolicy.py):
#   actions/checkout        11d5960a326750d5838078e36cf38b85af677262  (v4.4.0)
#   actions/setup-python    a26af69be951a213d495a4c3e4e4022e16d87065  (v5.6.0)
#   actions/download-artifact 634f93cb2916e3fdff6788551b99b062d0335ce0 (v5.0.0)

name: trusted-lane-d2-generation

on:
  workflow_dispatch:
    inputs:
      # The D1 RUN, not a digest of its plan. A digest handed to D2 alongside a
      # plan is not a binding: the digest identifies a plan, and whoever
      # supplies the plan chooses which plan gets identified. D2 downloads
      # both of D1's signed documents from this run and verifies both
      # signatures before it reads either.
      d1_run_id:
        description: Workflow run id of the D1 count that produced the plan
        required: true
        type: string
      generation_authorization_sha256:
        description: Digest of the separate operator generation approval
        required: true
        type: string

permissions:
  contents: read

defaults:
  run:
    shell: bash

jobs:
  d2-containment-gate:
    runs-on: ubuntu-latest
    permissions:
      contents: read
    steps:
      - name: Check out the trusted engine from the protected ref only
        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262  # v4.4.0
        with:
          persist-credentials: false
          fetch-depth: 0
      - name: Set up Python
        uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065  # v5.6.0
        with:
          python-version: '3.12'
      - name: Containment invariants
        env:
          EVENT_REPOSITORY_ID: ${{ github.repository_id }}
          OBSERVED_REF: ${{ github.ref }}
        run: |
          python - <<'PROBE'
          import os, sys
          sys.path.insert(0, "scripts")
          from trustedlane import enginepolicy, identity
          identity.assert_repository_numeric_id(int(os.environ["EVENT_REPOSITORY_ID"]))
          identity.assert_allowed_default_ref(os.environ["OBSERVED_REF"])
          enginepolicy.assert_no_candidate_import()
          PROBE

  trusted-cross-vendor-review:
    needs: d2-containment-gate
    runs-on: ubuntu-latest
    environment: trusted-verifier-generation
    permissions:
      contents: read
      # To download D1's private artifacts BY RUN ID. Read-only, and the
      # narrowest scope that can reach another run's output.
      actions: read
    steps:
      - name: Check out the trusted engine from the protected ref only
        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262  # v4.4.0
        with:
          persist-credentials: false
          fetch-depth: 0

      - name: Set up Python
        uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065  # v5.6.0
        with:
          python-version: '3.12'

      # Hash-locked, one package, no pytest — the same lock D1 installs, for
      # the same reason: a pinned version still lets a compromised index serve
      # different bytes under the same number, on a machine about to hold a key.
      - name: Install the hash-locked runtime
        run: |
          python -m pip install --require-hashes --no-deps \
            -r requirements-trusted-runtime.txt

      # R06 — MATERIALIZATION. Same block as D1, plus D1's two signed
      # documents. None of these paths had a producer: every one of them named
      # a file nothing in this workflow wrote.
      - name: Materialize the operator documents
        env:
          TRUSTED_PROTECTED_STATE_OBSERVATION: ${{ secrets.TRUSTED_PROTECTED_STATE_OBSERVATION }}
          TRUSTED_OPERATOR_RECORDS: ${{ secrets.TRUSTED_OPERATOR_RECORDS }}
          TRUSTED_OPERATOR_REVOCATIONS: ${{ secrets.TRUSTED_OPERATOR_REVOCATIONS }}
          TRUSTED_OBSERVATION_PATH: ${{ runner.temp }}/protected-state.json
          TRUSTED_OPERATOR_RECORDS_PATH: ${{ runner.temp }}/operator-records.json
          TRUSTED_REVOCATION_LIST_PATH: ${{ runner.temp }}/operator-revocations.json
          TRUSTED_MATERIALIZATION_DIR: ${{ runner.temp }}
        run: |
          python - <<'PROBE'
          import json, os, sys
          sys.path.insert(0, "scripts")
          from trustedlane import inputmaterial
          record = inputmaterial.write_secret_documents(
              os.environ,
              destination_dir=os.environ["TRUSTED_MATERIALIZATION_DIR"])
          print(json.dumps({k: v["document_sha256"][:16]
                            for k, v in record["materialized"].items()}))
          PROBE

      - name: Download the approved engine release
        env:
          GITHUB_TOKEN: ${{ github.token }}
          TRUSTED_ENGINE_RELEASE_TAG: ${{ vars.TRUSTED_ENGINE_RELEASE_TAG }}
          TRUSTED_ENGINE_DIGEST: ${{ vars.TRUSTED_ENGINE_ARTIFACT_SHA256 }}
          TRUSTED_ENGINE_ARTIFACT_PATH: ${{ runner.temp }}/engine.tar.gz
          TRUSTED_ENGINE_IDENTITY_PATH: ${{ runner.temp }}/engine-identity.json
          TRUSTED_MATERIALIZATION_DIR: ${{ runner.temp }}
        run: |
          python - <<'PROBE'
          import json, os, sys, urllib.request
          sys.path.insert(0, "scripts")
          from trustedlane import inputmaterial

          def fetch(url, *, accept):
              request = urllib.request.Request(url, headers={
                  "authorization": f"Bearer {os.environ['GITHUB_TOKEN']}",
                  "accept": accept,
                  "x-github-api-version": "2022-11-28"})
              with urllib.request.urlopen(request, timeout=120) as reply:
                  return reply.read(inputmaterial.MAX_ASSET_BYTES + 1)

          record = inputmaterial.fetch_engine_release(
              os.environ,
              destination_dir=os.environ["TRUSTED_MATERIALIZATION_DIR"],
              fetch=fetch)
          print(json.dumps({"tag": record["release_tag"]}))
          PROBE

      # D1's two SIGNED documents, from the D1 run that produced them. The
      # plan is PRIVATE — it carries the exact prompt bytes of every request —
      # so it is a retained private artifact of that run and never a release
      # asset or a repository file. Downloaded by run id rather than pasted
      # into a secret: D2 compares the run id it came from against the plan's
      # own, and a pasted document is one whose freshness nobody tracks.
      - name: Download D1's signed executable plan
        uses: actions/download-artifact@634f93cb2916e3fdff6788551b99b062d0335ce0  # v5.0.0
        env:
          TRUSTED_PLAN_PATH: ${{ runner.temp }}/trusted-executable-plan.json
        with:
          name: trusted-executable-plan
          path: ${{ runner.temp }}
          run-id: ${{ inputs.d1_run_id }}
          github-token: ${{ github.token }}

      - name: Download D1's signed count evidence
        uses: actions/download-artifact@634f93cb2916e3fdff6788551b99b062d0335ce0  # v5.0.0
        env:
          TRUSTED_COUNT_EVIDENCE_PATH: ${{ runner.temp }}/trusted-count-evidence.json
        with:
          name: trusted-count-evidence
          path: ${{ runner.temp }}
          run-id: ${{ inputs.d1_run_id }}
          github-token: ${{ github.token }}

      - name: Verify and unpack the approved engine artifact
        env:
          TRUSTED_ENGINE_DIGEST: ${{ vars.TRUSTED_ENGINE_ARTIFACT_SHA256 }}
          TRUSTED_ENGINE_ARTIFACT_PATH: ${{ runner.temp }}/engine.tar.gz
          TRUSTED_ENGINE_ROOT: ${{ runner.temp }}/engine
        run: |
          mkdir -p "$TRUSTED_ENGINE_ROOT"
          python - <<'PROBE'
          import json, os, sys
          sys.path.insert(0, "scripts")
          from trustedlane import artifactload
          record = artifactload.extract(
              os.environ["TRUSTED_ENGINE_ARTIFACT_PATH"],
              destination=os.environ["TRUSTED_ENGINE_ROOT"],
              expected_sha256=os.environ["TRUSTED_ENGINE_DIGEST"])
          artifactload.assert_engine_root_is_not_the_candidate(
              os.environ["TRUSTED_ENGINE_ROOT"])
          print(json.dumps({"files": record["file_count"],
                            "sha256": record["engine_artifact_sha256"]}))
          PROBE

      - name: Trusted generation
        env:
          # A DIFFERENT secret in a DIFFERENT environment under a DIFFERENT
          # operator prerequisite. Reusing D1's would make an approval to count
          # an approval to generate by accident.
          TRUSTED_VERIFIER_OPENAI_KEY: ${{ secrets.TRUSTED_VERIFIER_OPENAI_KEY }}
          TRUSTED_EVIDENCE_SIGNING_KEY: ${{ secrets.TRUSTED_EVIDENCE_SIGNING_KEY }}
          # R07. The installation token that sets the trusted status on the
          # candidate head. A THIRD capability, in its own variable and read
          # through its own function: a lane that obtained the provider key
          # and this one through one call would grant both wherever it
          # granted either. Environment-scoped like the others, so it is
          # unreachable from an unapproved ref.
          TRUSTED_STATUS_TOKEN: ${{ secrets.TRUSTED_STATUS_TOKEN }}
          # `TRUSTED_PLAN_SHA256` is GONE, and so is
          # `TRUSTED_ENGINE_SOURCE_SHA256`. The first was a digest handed to D2
          # beside a plan, which is not a binding; the second was a second copy
          # of a digest the engine identity record already carries, and two
          # copies of one fact is how they end up disagreeing.
          TRUSTED_PLAN_PATH: ${{ runner.temp }}/trusted-executable-plan.json
          TRUSTED_COUNT_EVIDENCE_PATH: ${{ runner.temp }}/trusted-count-evidence.json
          TRUSTED_CANDIDATE_CHECKOUT: ${{ runner.temp }}/candidate
          GENERATION_AUTHORIZATION_SHA256: ${{ inputs.generation_authorization_sha256 }}
          TRUSTED_ENGINE_ROOT: ${{ runner.temp }}/engine
          TRUSTED_ENGINE_ARTIFACT_PATH: ${{ runner.temp }}/engine.tar.gz
          TRUSTED_ENGINE_DIGEST: ${{ vars.TRUSTED_ENGINE_ARTIFACT_SHA256 }}
          TRUSTED_ENGINE_IDENTITY_PATH: ${{ runner.temp }}/engine-identity.json
          TRUSTED_BOOTSTRAP_HEAD_SHA: ${{ github.sha }}
          TRUSTED_WORKFLOW_DIR: .github/workflows
          TRUSTED_OBSERVATION_PATH: ${{ runner.temp }}/protected-state.json
          TRUSTED_OPERATOR_RECORDS_PATH: ${{ runner.temp }}/operator-records.json
          # `TRUSTED_MODEL_ID` is GONE. It let a repository variable name
          # ONE model, so a check published as a cross-vendor review asked
          # a single model and whoever could edit that variable chose
          # which. The panel is `verifier.policy.REQUESTED_MODEL_IDS`.
          #
          # The trust store decides what counts as an operator
          # authorization, so it is an ENVIRONMENT secret like the provider
          # credential — never a repository or organization one.
          TRUSTED_OPERATOR_TRUST_STORE: ${{ secrets.TRUSTED_OPERATOR_TRUST_STORE }}
          # Required, not optional: "no list" is not "no revocations", and a
          # lane that treats a missing list as empty cannot be told to stop.
          TRUSTED_REVOCATION_LIST_PATH: ${{ runner.temp }}/operator-revocations.json
          TARGET_BASE_SHA: ${{ vars.TRUSTED_TARGET_BASE_SHA }}
          CANDIDATE_HEAD_SHA: ${{ vars.TRUSTED_CANDIDATE_HEAD_SHA }}
          TRUSTED_RUN_ID: ${{ github.run_id }}
          TRUSTED_RUN_ATTEMPT: ${{ github.run_attempt }}
          TRUSTED_RUN_URL: ${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }}
          OBSERVED_REF: ${{ github.ref }}
          EVENT_REPOSITORY_ID: ${{ github.repository_id }}
        run: |
          # From the runner's clock, not a `vars.` repository variable — see
          # the note in the D1 template. An expiry compared against a frozen
          # instant never expires.
          export TRUSTED_OBSERVED_NOW="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
          # `laneentry` keeps every traceback out of a credential-bearing log.
          python -c 'import sys; sys.path.insert(0, "scripts"); \
            from trustedlane import laneentry; \
            sys.exit(laneentry.main("D2"))'
