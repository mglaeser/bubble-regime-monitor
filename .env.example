# --- Anthropic (judgment-call generator) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-opus-4-8
ANTHROPIC_EFFORT=max
ANTHROPIC_MAX_TOKENS=8000

# --- FRED ---
FRED_API_KEY=abcdefghijklmnopqrstuvwxyz123456   # optional; keyless fredgraph.csv fallback exists

# --- PRICE LAYER (v3.1 — now REQUIRED for a functioning price layer) ---
# Stooq's CSV endpoint now fronts a JS proof-of-work anti-bot gate a headless
# service cannot pass, so it is disabled by default. Without at least one of
# the two keys below, the price layer cannot function.
TIINGO_API_KEY=            # REQUIRED. Free: https://www.tiingo.com  (50 req/hr, 1000/day, 500 symbols/mo)
TWELVE_DATA_API_KEY=       # REQUIRED. Free: https://twelvedata.com  (8 req/min, 800 credits/day)
ALPHAVANTAGE_API_KEY=      # OPTIONAL (25 req/day) — CORE tickers emergency only
STOOQ_ENABLED=false        # Experimental PoW-solver path. Default OFF (ToS caveat; see app/sources/stooq.py)
TWELVE_DATA_INDICES=false  # true ONLY on Twelve Data Grow ($29/mo): raw GSPC/NDX instead of ETF proxies
FMP_API_KEY=               # optional; SEC fundamentals fallback

# --- Admin / security ---
# MUST be set to a strong random value. The service FAILS CLOSED on this exact
# placeholder (and on empty): admin endpoints return 503 until a real key is set
# (audit B-06/C-01). Generate one, e.g.:  python -c "import secrets;print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=change-me-to-a-long-random-string
READ_ENDPOINTS_PUBLIC=true

# --- SEC EDGAR etiquette (MANDATORY, format: "Name email") ---
SEC_USER_AGENT=bubblegauge-monitor admin@example.com
# SEC_EDGAR_UA overrides SEC_USER_AGENT if set (v3.1 name):
SEC_EDGAR_UA=

# --- Runtime ---
TZ=UTC
MC_SAMPLES=100000
MC_SEED=20260711
DB_URL=sqlite:////data/bubble.db
LOG_LEVEL=INFO
GSADF_CONTESTED=true
# LPPLS fit is CPU-heavy; the Atom N2800 needs generous headroom. 600 caused the
# first-live-run timeouts — keep >= 1500 (matches the code default). (audit A-32)
LPPLS_TIMEOUT_S=1500
GSADF_TIMEOUT_S=1800

# --- DAILY SMS DIGEST (sipgate REST API v2; optional) ---
# Once a day the service can text the score + a tiny LLM report as a single
# SMS. Auth is a sipgate Personal Access Token (scope sessions:sms:write):
# create one at https://app.sipgate.com -> Personal Access Tokens.
SMS_ENABLED=false                 # master switch for the daily digest job
SIPGATE_TOKEN_ID=                 # PAT token ID (Basic-auth username), e.g. token-XXXX
SIPGATE_TOKEN=                    # PAT token (Basic-auth password)
SIPGATE_SMS_ID=s0                 # Web SMS extension ('s' + number)
SIPGATE_RECIPIENT=                # recipient in E.164 format, e.g. +49151...
SMS_DAILY_HOUR=8                  # UTC hour for the daily digest
SMS_DAILY_MINUTE=0

# --- ALERT SYSTEM (docs/ALERT_STAGE0_AUDIT.md) ---
# Stage 0 only adds typed, non-scoring snapshot outputs. There is no alert
# evaluation, no alert API and no alert delivery yet, so nothing below is read
# by the running service — the names are reserved so an operator can see the
# shape of the rollout and so no later stage silently invents a default.
#
# Evidence capture and notification mode are INDEPENDENT switches: capture may
# run with alerting fully disabled, and enabling alerts never implies capture.
# ALERTS_MODE=live never happens automatically — it requires promoted rule and
# phrase artifacts plus a deliberate operator action.
ALERT_INPUT_CAPTURE=false         # Stage 1: persist the point-in-time alert sidecar
ALERTS_MODE=disabled              # disabled | shadow | live
