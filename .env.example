# --- Anthropic (judgment-call generator) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-opus-4-8
ANTHROPIC_EFFORT=max
ANTHROPIC_MAX_TOKENS=8000

# --- FRED ---
FRED_API_KEY=abcdefghijklmnopqrstuvwxyz123456   # optional; keyless fredgraph.csv fallback exists

# --- PRICE LAYER (v3.1 — now REQUIRED for a functioning price layer) ---
# Stooq's CSV endpoint now fronts a JS proof-of-work anti-bot gate a headless
# service cannot pass, so it is disabled by default. Without at least one of
# the two keys below, the price layer cannot function.
TIINGO_API_KEY=            # REQUIRED. Free: https://www.tiingo.com  (50 req/hr, 1000/day, 500 symbols/mo)
TWELVE_DATA_API_KEY=       # REQUIRED. Free: https://twelvedata.com  (8 req/min, 800 credits/day)
ALPHAVANTAGE_API_KEY=      # OPTIONAL (25 req/day) — CORE tickers emergency only
STOOQ_ENABLED=false        # Experimental PoW-solver path. Default OFF (ToS caveat; see app/sources/stooq.py)
TWELVE_DATA_INDICES=false  # true ONLY on Twelve Data Grow ($29/mo): raw GSPC/NDX instead of ETF proxies
FMP_API_KEY=               # optional; SEC fundamentals fallback

# --- Admin / security ---
# MUST be set to a strong random value. The service FAILS CLOSED on this exact
# placeholder (and on empty): admin endpoints return 503 until a real key is set
# (audit B-06/C-01). Generate one, e.g.:  python -c "import secrets;print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=change-me-to-a-long-random-string
READ_ENDPOINTS_PUBLIC=true

# --- SEC EDGAR etiquette (MANDATORY, format: "Name email") ---
SEC_USER_AGENT=bubblegauge-monitor admin@example.com
# SEC_EDGAR_UA overrides SEC_USER_AGENT if set (v3.1 name):
SEC_EDGAR_UA=

# --- Runtime ---
TZ=UTC
MC_SAMPLES=100000
MC_SEED=20260711
DB_URL=sqlite:////data/bubble.db
LOG_LEVEL=INFO
GSADF_CONTESTED=true
# LPPLS fit is CPU-heavy; the Atom N2800 needs generous headroom. 600 caused the
# first-live-run timeouts — keep >= 1500 (matches the code default). (audit A-32)
LPPLS_TIMEOUT_S=1500
GSADF_TIMEOUT_S=1800

# --- DAILY SMS DIGEST (sipgate REST API v2; optional) ---
# Once a day the service can text the score + a tiny LLM report as a single
# SMS. Auth is a sipgate Personal Access Token (scope sessions:sms:write):
# create one at https://app.sipgate.com -> Personal Access Tokens.
SMS_ENABLED=false                 # master switch for the daily digest job
SIPGATE_TOKEN_ID=                 # PAT token ID (Basic-auth username), e.g. token-XXXX
SIPGATE_TOKEN=                    # PAT token (Basic-auth password)
SIPGATE_SMS_ID=s0                 # Web SMS extension ('s' + number)
SIPGATE_RECIPIENT=                # recipient in E.164 format, e.g. +49151...
SMS_DAILY_HOUR=8                  # UTC hour for the daily digest
SMS_DAILY_MINUTE=0

# --- DAILY DIGEST OVER iMESSAGE (imessage-proxy; optional) ---
# The same daily digest, delivered through an imessage-proxy instance
# (POST {IMESSAGE_API_BASE_URL}/api/messages) instead of over SMS. Schedule and
# body are shared with the SMS path: SMS_DAILY_HOUR/MINUTE and SMS_MAX_LEN
# still apply.
#
# EXACTLY ONE TRANSPORT SENDS. If both IMESSAGE_ENABLED and SMS_ENABLED are
# true, iMessage wins and sipgate is not called. There is deliberately no
# fallback: delivering the digest twice is a defect, and quietly downgrading to
# SMS would hide the proxy being down at the moment you most need to know.
#
# MIND THE SPELLING. Settings are loaded with extra="ignore", so an
# unrecognised key is dropped WITHOUT ANY ERROR. `IMESSAG_ENABLED=true` — one
# character short — reads as "iMessage off", and combined with SMS_ENABLED=false
# it yields a service that sends nothing at all. The digest job now names a
# probable misspelling in its skip reason instead of just going quiet.
IMESSAGE_ENABLED=false
IMESSAGE_API_BASE_URL=            # origin ONLY, no path: https://messages.example.com
IMESSAGE_API_KEY=                 # scoped key with `messages:send` — NOT `admin`
IMESSAGE_RECIPIENT=               # +E.164 (e.g. +49151...) or an Apple-ID email
IMESSAGE_TIMEOUT_S=30             # read cap; the proxy's own send deadline is longer
#
# The recipient must ALSO be on the proxy's own allowlist. That list is
# admin-scoped: a `messages:send` key can neither read it nor add itself to it,
# so a destination missing from it fails with 403 no matter what you set here.
# Proxy keys also expire (90 days by default) — an expired key is a 401 and is
# indistinguishable from one that is simply wrong.

# --- ALERT SYSTEM (docs/ALERT_SYSTEM.md) ---
# Evidence capture and notification mode are INDEPENDENT switches: capture may
# run with alerting fully disabled, and enabling alerts never implies capture.
# ALERTS_MODE=live never happens automatically — it requires promoted rule and
# phrase artifacts plus a deliberate operator action.
#
# Capture defaults ON: that is what rollout Stage 1 IS, and the promoted
# ruleset says the same thing in `capture.enabled`. It writes one immutable
# evidence row per recompute in its own transaction — no provider call, no
# score touched, no snapshot rolled back — and without it there is nothing to
# replay. Set it to false to stop capture; the ruleset can also stop it.
#
# ALERTS_MODE is the flag that decides whether the service ACTS, and it
# defaults to disabled. Stage 1 leaves it there.
ALERT_INPUT_CAPTURE=true          # kill switch; the ruleset can also disable it
ALERTS_MODE=disabled              # disabled | shadow | live — Stage 1 stays disabled

# Frontend auth (H-05): the read key is BROWSER-VISIBLE, so it is a public
# capability rather than a secret. It reaches only the redacted projection —
# notably NOT rendered message text, which lives behind ADMIN_API_KEY at
# /api/v1/admin/alerts/renders/{id}. Set ALERTS_READ_TOKEN_IS_PUBLIC=false only
# if the read key never leaves a trusted server-side proxy.
#
# Rotate the browser token by moving the old value into *_PREVIOUS, deploying
# the new one, then clearing *_PREVIOUS. Both are accepted during the overlap,
# so the dashboard never needs a synchronized deploy.
ALERTS_READ_API_KEY=
ALERTS_READ_API_KEY_PREVIOUS=
ALERTS_WRITE_API_KEY=
ALERTS_READ_TOKEN_IS_PUBLIC=true
ALERTS_PUBLIC_READ_RATE_LIMIT=30/minute
