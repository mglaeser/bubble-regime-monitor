# Host-only settings and credentials must never enter an image.
.env
.env.*
**/.env
**/.env.*
.envrc
**/.envrc
# Backup and variant shapes of the same file. `cp .env .env.bak` was caught by
# `.env.*`; `cp .env prod.env` and an editor's `.env~` were not — and a backup
# of a credential file is the credential file.
*.env
**/*.env
*.env.*
**/*.env.*
.env~
**/.env~
*.env~
**/*.env~
# The template carries no secrets and the install one-liner copies from it.
# Re-included LAST: in ignore files the last match wins, so this negation must
# follow every pattern above that would otherwise swallow it.
!.env.example
secrets
**/secrets
.secrets
**/.secrets
*.key
**/*.key
*.pem
**/*.pem
*.p12
**/*.p12
*.pfx
**/*.pfx

# Private verifier drafts and unreviewed local package artifacts.
artifacts/verifier/mc3/*-skeleton.json
artifacts/verifier/mc3/*-plan.json
*.whl
**/*.whl
*.tar.gz
**/*.tar.gz

# Version-control metadata is not an application runtime input.
.git
**/.git

# Local Python environments.
.venv
**/.venv
venv
**/venv
env
**/env

