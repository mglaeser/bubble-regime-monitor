{
  "components": {
    "schemas": {
      "ActionabilityRequest": {
        "additionalProperties": false,
        "properties": {
          "action_type": {
            "anyOf": [
              {
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Action Type"
          },
          "actionable": {
            "pattern": "^(YES|NO|AMBIGUOUS)$",
            "title": "Actionable",
            "type": "string"
          },
          "comment": {
            "anyOf": [
              {
                "maxLength": 255,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Comment"
          },
          "delivery_id": {
            "anyOf": [
              {
                "maxLength": 32,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Delivery Id"
          },
          "episode_id": {
            "maxLength": 32,
            "minLength": 1,
            "title": "Episode Id",
            "type": "string"
          },
          "reason_code": {
            "anyOf": [
              {
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason Code"
          }
        },
        "required": [
          "episode_id",
          "actionable"
        ],
        "title": "ActionabilityRequest",
        "type": "object"
      },
      "EvaluateRequest": {
        "additionalProperties": false,
        "properties": {
          "input_identity": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Input Identity",
            "type": "string"
          },
          "shadow": {
            "default": true,
            "title": "Shadow",
            "type": "boolean"
          }
        },
        "required": [
          "input_identity"
        ],
        "title": "EvaluateRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ManualRetryRequest": {
        "additionalProperties": false,
        "properties": {
          "acknowledge_duplicate_risk": {
            "title": "Acknowledge Duplicate Risk",
            "type": "boolean"
          },
          "comment": {
            "maxLength": 255,
            "minLength": 1,
            "title": "Comment",
            "type": "string"
          }
        },
        "required": [
          "comment",
          "acknowledge_duplicate_risk"
        ],
        "title": "ManualRetryRequest",
        "type": "object"
      },
      "SilenceRequest": {
        "additionalProperties": false,
        "properties": {
          "comment": {
            "maxLength": 255,
            "minLength": 1,
            "title": "Comment",
            "type": "string"
          },
          "duration_seconds": {
            "maximum": 2592000.0,
            "minimum": 60.0,
            "title": "Duration Seconds",
            "type": "integer"
          },
          "matcher_kind": {
            "pattern": "^(RULE_ID|INSTANCE_FINGERPRINT|BUCKET|ALL)$",
            "title": "Matcher Kind",
            "type": "string"
          },
          "matcher_value": {
            "maxLength": 255,
            "minLength": 1,
            "title": "Matcher Value",
            "type": "string"
          },
          "starts_in_seconds": {
            "default": 0,
            "maximum": 2592000.0,
            "minimum": 0.0,
            "title": "Starts In Seconds",
            "type": "integer"
          }
        },
        "required": [
          "matcher_kind",
          "matcher_value",
          "duration_seconds",
          "comment"
        ],
        "title": "SilenceRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Alert-system subset of the bubblegauge OpenAPI document, generated from the running application. Reads use ALERTS_READ_API_KEY, writes use ALERTS_WRITE_API_KEY; neither falls back to the admin key. Research, not advice.",
    "title": "bubblegauge \u2014 alerts",
    "version": "3.9.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/admin/alerts/actionability": {
      "post": {
        "description": "One human label per alert, for the question the metrics cannot answer.\n\nEverything else in this system measures whether a message went out;\nnothing measures whether it was worth receiving. Stage 7 retains the LLM\nselector only if these labels show a material improvement, and AMBIGUOUS\nexists so an unsure reviewer does not inflate the KPI either way.",
        "operationId": "record_actionability_api_v1_admin_alerts_actionability_post",
        "parameters": [
          {
            "in": "header",
            "name": "x-api-key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Api-Key"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ActionabilityRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "title": "Response Record Actionability Api V1 Admin Alerts Actionability Post"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Record whether an alert was actionable",
        "tags": [
          "alerts-admin"
        ]
      }
    },
    "/api/v1/admin/alerts/deliveries/{delivery_id}/retry": {
      "post": {
        "description": "A NEW delivery that admits it may duplicate the old one.\n\nAn UNKNOWN outcome means the bytes may have reached the phone, so nothing\nretries it automatically \u2014 that is the four-outcome contract's whole point.\nWhen a human decides the silence is worse than a possible duplicate, that\ndecision is recorded, not smuggled: the retry requires an Idempotency-Key,\nan operator comment, and an explicit duplicate-risk acknowledgement, and it\ncreates a NEW delivery row with `manual_retry_sequence` incremented \u2014 same\nmembers, same notification generation \u2014 linked to the original through\n`prior_unknown_delivery_id`. The dedupe key differs BECAUSE the sequence is\nin its material; the audit trail survives because nothing is overwritten.",
        "operationId": "manual_retry_api_v1_admin_alerts_deliveries__delivery_id__retry_post",
        "parameters": [
          {
            "in": "path",
            "name": "delivery_id",
            "required": true,
            "schema": {
              "title": "Delivery Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Idempotency-Key"
            }
          },
          {
            "in": "header",
            "name": "x-api-key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Api-Key"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ManualRetryRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "title": "Response Manual Retry Api V1 Admin Alerts Deliveries  Delivery Id  Retry Post"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Manually retry an UNKNOWN delivery",
        "tags": [
          "alerts-admin"
        ]
      }
    },
    "/api/v1/admin/alerts/evaluate": {
      "post": {
        "description": "Run P0b/P1/P2 for a single sidecar without waiting for a recompute.\n\n`shadow=true` (the default) evaluates into the shadow namespace, which is\nhow a promoted ruleset is exercised before anything is allowed to send.",
        "operationId": "admin_evaluate_api_v1_admin_alerts_evaluate_post",
        "parameters": [
          {
            "in": "header",
            "name": "x-api-key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Api-Key"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EvaluateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "title": "Response Admin Evaluate Api V1 Admin Alerts Evaluate Post"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Evaluate one captured input",
        "tags": [
          "alerts-admin"
        ]
      }
    },
    "/api/v1/admin/alerts/promote": {
      "post": {
        "description": "Validate the artifacts on disk and PROMOTE them.\n\nDeliberately an explicit action with its own endpoint: nothing promotes as\na side effect of a boot, a deploy or a validation run. Promotion does not\nchange ALERTS_MODE \u2014 going live is still a separate operator decision.",
        "operationId": "admin_promote_api_v1_admin_alerts_promote_post",
        "parameters": [
          {
            "in": "header",
            "name": "x-api-key",
            "required": false,
