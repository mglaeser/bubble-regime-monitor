    "/api/v1/admin/alerts/render": {
      "post": {
        "description": "Validate the exact TEST body without persisting or sending anything.\n\nThis is a phrase-set/rendering probe, not a transport probe.  It resolves\nthe active reviewed ``TEST_MESSAGE`` and runs the same renderer used by an\naudited TEST delivery, but creates no delivery, render or provider call.",
        "operationId": "admin_preview_render_api_v1_admin_alerts_render_post",
        "parameters": [
          {
            "in": "header",
            "name": "x-api-key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
