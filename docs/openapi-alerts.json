        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "title": "Response Admin Preview Render Api V1 Admin Alerts Render Post"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Preview the reviewed TEST render",
        "tags": [
          "alerts-admin"
        ]
      }
    },
    "/api/v1/admin/alerts/renders/{render_id}": {
      "get": {
        "description": "The operator path to a rendered message body.\n\nThe read surface withholds `final_message` because the frontend uses a\nbrowser-visible scoped token (H-05), and the alert scopes deliberately do\nnot nest \u2014 there is no stronger key a caller could present to\n`/api/v1/alerts/renders/{id}`. So the text lives here, behind admin, and\n`no-store` keeps it out of any intermediary cache.",
        "operationId": "admin_get_render_api_v1_admin_alerts_renders__render_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "render_id",
            "required": true,
            "schema": {
              "title": "Render Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "x-api-key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Api-Key"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "title": "Response Admin Get Render Api V1 Admin Alerts Renders  Render Id  Get"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "One render, INCLUDING the text",
        "tags": [
          "alerts-admin"
        ]
      }
    },
    "/api/v1/admin/alerts/send-test": {
      "post": {
        "description": "Create a TEST delivery for the dispatcher to send.\n\nTEST is the one delivery kind allowed zero members: it is about the\nTRANSPORT, not about any market condition, and inventing an episode to\nhang it on would put a fake market event in the audit trail. It is also\noutside `BUDGETED_KINDS`, so proving the wire works never spends the\noperator's non-P1 budget \u2014 and its body is a reviewed phrase-set fragment\nlike every other message, not prose typed into a request.\n\nThe actual send happens through the ordinary dispatcher: same claim, same\nadmission, same classification. A test that bypassed the pipeline would\nprove something other than the thing the operator needs proven.",
        "operationId": "send_test_api_v1_admin_alerts_send_test_post",
        "parameters": [
          {
            "in": "header",
            "name": "x-api-key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Api-Key"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Send Test Api V1 Admin Alerts Send Test Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Queue an audited TEST delivery",
        "tags": [
          "alerts-admin"
        ]
      }
    },
